FROM node:20-slim
EXPOSE 3020

# Install necessary dependencies for building Angular
RUN apt-get update && apt-get install -y \
    curl \
    make \
    g++ \
    libpq-dev \
    git \
    bash && \
    npm install -g @angular/cli @angular-devkit/build-angular && \
    mkdir -p /wcr-front

WORKDIR /wcr-front

COPY . ./

RUN npm install --legacy-peer-deps

ARG NG_APP_PRODUCTION
ARG NG_APP_ANALYTICS_ENABLED
ARG NG_APP_STRIPE_PK
ARG NG_APP_BASE_URL
ARG NG_APP_WS_BASE
ARG NG_APP_JITSI_URL
ARG NG_APP_LOGROCKET_APP_ID
ARG NG_APP_PAYPAL_CLIENT_ID
ARG NG_APP_ONESIGNAL_APP_ID
ARG NG_APP_ONESIGNAL_SAFARI_WEB_ID
ARG NG_APP_ONESIGNAL_ALLOW_LOCALHOST_AS_SECURE_ORIGIN
ARG NG_APP_ENVIRONMENT
ARG NG_APP_GIT_REVISION
ARG BUCKET_ENVIRONMENT
ARG NG_APP_LUPAI_WS_URL
ARG NG_APP_LUPAI_TOKEN
ENV NG_APP_PRODUCTION=$NG_APP_PRODUCTION \
    NG_APP_ANALYTICS_ENABLED=$NG_APP_ANALYTICS_ENABLED \
    NG_APP_STRIPE_PK=$NG_APP_STRIPE_PK \
    NG_APP_BASE_URL=$NG_APP_BASE_URL \
    NG_APP_WS_BASE=$NG_APP_WS_BASE \
    NG_APP_JITSI_URL=$NG_APP_JITSI_URL \
    NG_APP_LOGROCKET_APP_ID=$NG_APP_LOGROCKET_APP_ID \
    NG_APP_PAYPAL_CLIENT_ID=$NG_APP_PAYPAL_CLIENT_ID \
    NG_APP_ONESIGNAL_APP_ID=$NG_APP_ONESIGNAL_APP_ID \
    NG_APP_ONESIGNAL_SAFARI_WEB_ID=$NG_APP_ONESIGNAL_SAFARI_WEB_ID \
    NG_APP_ONESIGNAL_ALLOW_LOCALHOST_AS_SECURE_ORIGIN=$NG_APP_ONESIGNAL_ALLOW_LOCALHOST_AS_SECURE_ORIGIN \
    NG_APP_ENVIRONMENT=$NG_APP_ENVIRONMENT \
    NG_APP_GIT_REVISION=$NG_APP_GIT_REVISION \
    BUCKET_ENVIRONMENT=$BUCKET_ENVIRONMENT \
    NG_APP_LUPAI_WS_URL=$NG_APP_LUPAI_WS_URL \
    NG_APP_LUPAI_TOKEN=$NG_APP_LUPAI_TOKEN \
    NODE_OPTIONS=--max_old_space_size=10000

RUN git rev-parse --abbrev-ref HEAD
RUN echo "Revision: $NG_APP_GIT_REVISION"

RUN npm run build:$NG_APP_ENVIRONMENT
WORKDIR /wcr-front/uppy-companions
RUN npm install
RUN mkdir tmp && chmod 755 tmp
CMD ["node", "app.js"]