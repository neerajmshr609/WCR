{
  "name": "greyt",
  "version": "3.6.6",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --allowed-hosts all",
    "start-local": "ng s -c local",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "prettier:cli": "prettier --loglevel warn",
    "prettier:check": "npm run prettier:cli -- --check .",
    "prettier:fix": "npm run prettier:cli -- --write .",
    "e2e": "ng e2e",
    "local": "ng s --host=0.0.0.0 --disable-host-check -c local",
    "build:qa": "ng build --configuration=qa",
    "build:prod": "ng build --configuration=production",
    "build:prod2": "ng build --configuration=prod2",
    "i18n:init": "ngx-translate-extract --input ./src --output ./src/assets/i18n/template.json --key-as-default-value --replace --format json",
    "i18n:extract": "ngx-translate-extract --input ./src --output ./src/assets/i18n/{en,da,de,fi,nb,nl,sv}.json --clean --format json",
    "update-locale": "ngx-translate-extract -i ./src -o src/assets/translations/home/*.json --sort --format namespaced-json",
    "prepare": "husky install"
  },
  "private": true,
